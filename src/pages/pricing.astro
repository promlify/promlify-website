---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Promlify | Pricing">
  
  <!-- Pricing Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-32 pb-16 text-center animate-fade-in">
    <div class="inline-flex items-center gap-2 border border-blue-500/30 bg-blue-900/20 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-mono tracking-wider text-blue-200 mb-6 shadow-[0_0_15px_rgba(59,130,246,0.2)]">
      TRANSPARENT PRICING
    </div>
    <h1 class="text-5xl md:text-7xl font-black font-serif tracking-tight text-white mb-6">
      Scale your workflows.<br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">No hidden fees.</span>
    </h1>
    <p class="text-lg text-indigo-200/80 max-w-2xl mx-auto mb-10">
      Choose the perfect plan for your AI generation needs. From solo creators to enterprise teams, we have a secure, high-performance node for you.
    </p>

    <!-- Monthly / Annual Toggle (Visual) -->
    <div class="flex items-center justify-center gap-3 text-sm font-medium">
      <span class="text-white">Monthly</span>
      <div class="w-12 h-6 bg-purple-600 rounded-full relative cursor-pointer shadow-[0_0_10px_rgba(139,92,246,0.5)]">
        <div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
      </div>
      <span class="text-indigo-200/60">Annually <span class="text-emerald-400 text-xs ml-1 bg-emerald-950/40 border border-emerald-900 px-1.5 py-0.5 rounded">Save 20%</span></span>
    </div>
  </section>

  <!-- Pricing Cards -->
  <section class="max-w-7xl mx-auto px-6 pb-32 relative animate-fade-in" style="animation-delay: 0.2s;">
    <!-- Background Ambient Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-3/4 bg-blue-600/10 blur-[150px] rounded-full -z-10"></div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      
      <!-- Tier 1: Starter -->
      <div class="bg-[#0A0A18]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 hover:bg-white/5 transition-colors h-full flex flex-col">
        <h3 class="text-xl font-bold text-white mb-2">Starter</h3>
        <p class="text-sm text-indigo-200/60 mb-6 h-10">Perfect for exploring the Promlify AI OS capabilities.</p>
        <div class="mb-8">
          <span class="text-4xl font-black text-white">$0</span>
          <span class="text-indigo-200/50">/mo</span>
        </div>
        <button class="w-full bg-white/5 border border-white/10 text-white font-semibold py-3 rounded-lg hover:bg-white/10 transition-colors mb-8">
          Start Free
        </button>
        <ul class="space-y-4 text-sm text-indigo-200/80 flex-grow">
          <li class="flex items-center gap-3">
            <span class="text-blue-400">✓</span> 100 Base Credits / month
          </li>
          <li class="flex items-center gap-3">
            <span class="text-blue-400">✓</span> Standard Generation Speed
          </li>
          <li class="flex items-center gap-3">
            <span class="text-blue-400">✓</span> Community Support
          </li>
        </ul>
      </div>

      <!-- Tier 2: Pro (Highlighted) -->
      <div class="relative group">
        <!-- Animated glowing border -->
        <div class="absolute -inset-[2px] bg-gradient-to-b from-blue-500 via-purple-500 to-fuchsia-500 rounded-2xl blur opacity-50 group-hover:opacity-75 transition duration-500"></div>
        <div class="relative bg-[#050511] backdrop-blur-2xl border border-white/10 rounded-2xl p-8 h-[105%] flex flex-col shadow-[0_0_40px_rgba(139,92,246,0.3)] z-10">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-gradient-to-r from-blue-600 to-purple-600 text-white text-xs font-bold uppercase tracking-wider px-4 py-1 rounded-full shadow-lg">
            Most Popular
          </div>
          <h3 class="text-xl font-bold text-white mb-2 mt-2">Pro License</h3>
          <p class="text-sm text-indigo-200/60 mb-6 h-10">For creators and engineers demanding absolute precision.</p>
          <div class="mb-8">
            <span class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400">$49</span>
            <span class="text-indigo-200/50">/mo</span>
          </div>
          <button class="w-full bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold py-3 rounded-lg hover:opacity-90 hover:shadow-[0_0_20px_rgba(139,92,246,0.4)] transition-all mb-8">
            Upgrade to Pro
          </button>
          <ul class="space-y-4 text-sm text-indigo-200/90 flex-grow font-medium">
            <li class="flex items-center gap-3">
              <span class="text-purple-400 font-bold">✓</span> Unlimited Local Generations
            </li>
            <li class="flex items-center gap-3">
              <span class="text-purple-400 font-bold">✓</span> Priority Smart Context API
            </li>
            <li class="flex items-center gap-3">
              <span class="text-purple-400 font-bold">✓</span> Commercial Usage Rights
            </li>
            <li class="flex items-center gap-3">
              <span class="text-purple-400 font-bold">✓</span> Zero-Latency Edge Access
            </li>
          </ul>
        </div>
      </div>

      <!-- Tier 3: Enterprise -->
      <div class="bg-[#0A0A18]/80 backdrop-blur-xl border border-white/10 rounded-2xl p-8 hover:bg-white/5 transition-colors h-full flex flex-col">
        <h3 class="text-xl font-bold text-white mb-2">Enterprise</h3>
        <p class="text-sm text-indigo-200/60 mb-6 h-10">Custom infrastructure for scaling organizations.</p>
        <div class="mb-8">
          <span class="text-4xl font-black text-white">Custom</span>
        </div>
        <button class="w-full bg-white text-black font-semibold py-3 rounded-lg hover:bg-gray-200 transition-colors mb-8">
          Contact Sales
        </button>
        <ul class="space-y-4 text-sm text-indigo-200/80 flex-grow">
          <li class="flex items-center gap-3">
            <span class="text-white/50">✓</span> Dedicated GPU Clusters
          </li>
          <li class="flex items-center gap-3">
            <span class="text-white/50">✓</span> Custom Model Fine-tuning
          </li>
          <li class="flex items-center gap-3">
            <span class="text-white/50">✓</span> 24/7 SLA Support
          </li>
        </ul>
      </div>

    </div>
  </section>
</Layout>