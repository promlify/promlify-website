---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Promlify | Pricing">
  <div class="max-w-4xl mx-auto px-6 pt-32 pb-24 text-center animate-fade-in">
    <h1 class="text-4xl md:text-5xl font-black font-serif text-white mb-6">Simple, transparent pricing.</h1>
    <p class="text-lg text-indigo-200/80 mb-12">Unlock the full power of AuraPrompt and the Promlify ecosystem.</p>
    
    <div class="p-[1px] rounded-xl bg-gradient-to-br from-blue-500/50 via-purple-500/50 to-transparent shadow-[0_0_30px_rgba(139,92,246,0.3)] max-w-sm mx-auto">
      <div class="bg-[#0A0A18]/90 backdrop-blur-xl rounded-xl p-8 text-left">
        <h3 class="text-xl font-bold text-white mb-2">Pro License</h3>
        <div class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-purple-400 mb-6">$49<span class="text-sm font-normal text-indigo-200/50">/mo</span></div>
        <ul class="space-y-3 mb-8 text-sm text-indigo-200/80">
          <li>✓ Unlimited Local Generations</li>
          <li>✓ Priority Smart Context API</li>
          <li>✓ Commercial Usage Rights</li>
        </ul>
        <button class="w-full bg-white text-black font-semibold py-3 rounded-md hover:bg-gray-200 transition-colors">Get Started</button>
      </div>
    </div>
  </div>
</Layout>