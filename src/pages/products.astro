---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Promlify | Ecosystem & Products">
  
  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-6 pt-32 pb-20 text-center animate-fade-in">
    <div class="inline-flex items-center gap-2 border border-purple-500/30 bg-purple-900/20 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-mono tracking-wider text-purple-200 mb-6 shadow-[0_0_15px_rgba(139,92,246,0.2)]">
      <span class="w-1.5 h-1.5 rounded-full bg-fuchsia-400 animate-pulse"></span>
      THE PROMLIFY ECOSYSTEM
    </div>
    <h1 class="text-5xl md:text-7xl font-black font-serif tracking-tight text-white mb-6">
      Tools engineered <br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-fuchsia-400">for absolute scale.</span>
    </h1>
    <p class="text-lg text-indigo-200/80 max-w-2xl mx-auto">
      Explore our suite of localized, zero-latency artificial intelligence engines designed specifically for enterprise workflows and advanced creators.
    </p>
  </section>

  <!-- PRODUCT 1: AURAPROMPT (Flagship) -->
  <section class="max-w-7xl mx-auto px-6 py-24 relative animate-fade-in" style="animation-delay: 0.2s;">
    <!-- Background Glow for AuraPrompt -->
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-1/2 h-1/2 bg-blue-600/10 blur-[120px] rounded-full -z-10"></div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Visual Mockup (Left) -->
      <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-purple-600 rounded-2xl blur opacity-25 group-hover:opacity-50 transition duration-1000 group-hover:duration-200"></div>
        <div class="relative bg-[#0A0A18]/90 backdrop-blur-xl border border-white/10 rounded-2xl p-6 shadow-2xl overflow-hidden h-[400px] flex flex-col">
          <div class="flex justify-between items-center border-b border-white/5 pb-4 mb-4">
            <div class="flex items-center gap-2">
              <span class="text-white font-bold tracking-tight">AuraPrompt</span>
              <span class="text-[10px] bg-blue-500/20 text-blue-300 px-2 py-0.5 rounded-full border border-blue-500/30">v1.2</span>
            </div>
            <div class="flex gap-1.5">
              <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
              <div class="w-2.5 h-2.5 rounded-full bg-white/20"></div>
            </div>
          </div>
          <!-- Abstract UI Blocks -->
          <div class="flex-grow space-y-4">
            <div class="h-8 w-1/3 bg-white/5 rounded animate-pulse"></div>
            <div class="h-32 w-full bg-gradient-to-br from-white/5 to-transparent border border-white/5 rounded-lg flex items-center justify-center">
              <span class="text-white/20 font-mono text-sm">Waiting for prompt compilation...</span>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div class="h-16 bg-white/5 rounded-lg"></div>
              <div class="h-16 bg-white/5 rounded-lg"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Text Content (Right) -->
      <div class="space-y-8">
        <div>
          <h2 class="text-3xl md:text-5xl font-black text-white mb-4">AuraPrompt</h2>
          <p class="text-xl text-indigo-200/80 leading-relaxed">
            Our flagship structural generation hub. Built for production environments demanding absolute precision and seamless workflow execution.
          </p>
        </div>
        
        <ul class="space-y-4">
          <li class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-blue-500/20 border border-blue-500/30 flex items-center justify-center shrink-0 mt-1">
              <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            </div>
            <div>
              <h4 class="text-white font-bold">Dynamic Structural Context</h4>
              <p class="text-sm text-indigo-200/60 mt-1">Maintains deep contextual memory across highly complex, multi-stage generation tasks.</p>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-purple-500/20 border border-purple-500/30 flex items-center justify-center shrink-0 mt-1">
              <span class="w-2 h-2 rounded-full bg-purple-400"></span>
            </div>
            <div>
              <h4 class="text-white font-bold">Zero-Latency Local Execution</h4>
              <p class="text-sm text-indigo-200/60 mt-1">Bypass cloud bottlenecks. Process workflows directly on edge architecture.</p>
            </div>
          </li>
        </ul>

        <div class="flex gap-4 pt-4">
          <a href="#" class="bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold px-8 py-3 rounded-md hover:scale-105 hover:shadow-[0_0_20px_rgba(139,92,246,0.4)] transition-all">
            Launch AuraPrompt
          </a>
          <a href="#" class="bg-transparent border border-white/20 text-white font-semibold px-8 py-3 rounded-md hover:bg-white/5 transition-all">
            Documentation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Divider -->
  <div class="max-w-7xl mx-auto px-6 py-8">
    <div class="w-full h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
  </div>

  <!-- PRODUCT 2: TEMPORAL-V2 (Pipeline / Alternating Layout) -->
  <section class="max-w-7xl mx-auto px-6 py-24 relative animate-fade-in" style="animation-delay: 0.4s;">
    <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-1/2 h-1/2 bg-fuchsia-600/10 blur-[120px] rounded-full -z-10"></div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Text Content (Left - Alternated) -->
      <div class="space-y-8 order-2 lg:order-1">
        <div>
          <div class="inline-block bg-white/10 text-white text-[10px] font-mono tracking-widest uppercase px-3 py-1 rounded-full mb-4 border border-white/10 backdrop-blur-md">
            In Development Pipeline
          </div>
          <h2 class="text-3xl md:text-5xl font-black text-white mb-4">Temporal-V2 Engine</h2>
          <p class="text-xl text-indigo-200/80 leading-relaxed">
            The next evolution in AI video rendering. Input camera motion trajectories, frame-interpolation dynamics, and strict prompt sequence constraints.
          </p>
        </div>
        
        <ul class="space-y-4">
          <li class="flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0 mt-1">
              <span class="w-2 h-2 rounded-full bg-white/40"></span>
            </div>
            <div>
              <h4 class="text-white font-bold text-white/80">Cinematic Prompt Sequencing</h4>
              <p class="text-sm text-indigo-200/50 mt-1">Link multiple prompts across a unified timeline to generate cohesive short films.</p>
            </div>
          </li>
        </ul>

        <div class="pt-4">
          <button disabled class="bg-white/5 border border-white/10 text-white/40 font-semibold px-8 py-3 rounded-md cursor-not-allowed">
            Beta Access Closed
          </button>
        </div>
      </div>

      <!-- Visual Mockup (Right - Alternated) -->
      <div class="relative group order-1 lg:order-2">
        <div class="absolute -inset-1 bg-gradient-to-r from-fuchsia-600 to-purple-600 rounded-2xl blur opacity-10 group-hover:opacity-30 transition duration-1000 group-hover:duration-200"></div>
        <div class="relative bg-[#050511]/80 backdrop-blur-xl border border-white/5 rounded-2xl p-2 shadow-2xl overflow-hidden h-[400px] flex flex-col grayscale opacity-80">
           <!-- Timeline abstract mockup -->
           <div class="h-2/3 bg-black/50 rounded-xl border border-white/5 mb-2 relative overflow-hidden">
             <!-- Fake video playbar -->
             <div class="absolute bottom-4 left-4 right-4 h-1 bg-white/10 rounded-full">
               <div class="w-1/3 h-full bg-fuchsia-500/50 rounded-full"></div>
             </div>
           </div>
           <div class="h-1/3 flex gap-2">
             <div class="flex-1 bg-white/5 rounded-lg border border-white/5"></div>
             <div class="flex-1 bg-white/5 rounded-lg border border-white/5"></div>
             <div class="flex-1 bg-white/5 rounded-lg border border-white/5"></div>
           </div>
        </div>
      </div>
      
    </div>
  </section>

</Layout>