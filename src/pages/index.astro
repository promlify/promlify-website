---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Promlify | One Platform. Every AI Tool.">
  
  <!-- Content starts immediately, Layout handles the header! -->
  <div class="max-w-7xl mx-auto px-6 pt-20 pb-32 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center relative">
    
    <!-- Left Copy Column -->
    <div class="lg:col-span-5 space-y-8 animate-fade-in">
      <div class="inline-flex items-center gap-2 border border-purple-500/30 bg-purple-900/20 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-mono tracking-wider text-purple-200 shadow-[0_0_15px_rgba(139,92,246,0.2)]">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse shadow-[0_0_8px_rgba(96,165,250,0.8)]"></span>
        AI OPERATING SYSTEM
      </div>
      
      <h1 class="text-5xl md:text-6xl font-black font-serif tracking-tight text-white leading-[1.1]">
        One Platform.<br/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-fuchsia-400 drop-shadow-sm">Every AI Tool.</span>
      </h1>
      
      <p class="text-lg text-indigo-200/80 leading-relaxed font-normal">
        Create, automate, and scale with the most powerful AI models deployed in one unified, beautifully designed workspace.
      </p>
      
      <div class="flex flex-wrap gap-4 pt-2">
        <button class="bg-gradient-to-r from-blue-600 to-purple-600 text-white font-medium px-8 py-3.5 rounded-full hover:opacity-90 hover:-translate-y-0.5 transition-all shadow-[0_0_25px_rgba(139,92,246,0.5)]">
          Launch Workspace
        </button>
        <button class="bg-white/5 border border-white/10 text-white font-medium px-8 py-3.5 rounded-full hover:bg-white/10 hover:border-white/20 transition-all backdrop-blur-sm">
          Watch Demo
        </button>
      </div>
    </div>

    <!-- Right Interactive OS Simulator Box -->
    <div class="lg:col-span-7 animate-fade-in" style="animation-delay: 0.2s;">
      <div class="p-[1px] rounded-xl bg-gradient-to-br from-blue-500/30 via-purple-500/10 to-transparent shadow-[0_20px_50px_rgba(0,0,0,0.5)]">
        <div class="bg-[#0A0A18]/90 backdrop-blur-2xl rounded-xl overflow-hidden">
          
          <div class="bg-[#101025]/80 border-b border-white/5 px-4 py-3 flex justify-between items-center">
            <div class="flex gap-1.5">
              <span class="w-3 h-3 rounded-full bg-red-400/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-400/80"></span>
              <span class="w-3 h-3 rounded-full bg-green-400/80"></span>
            </div>
            <span class="text-xs font-mono tracking-wide text-indigo-300/50 flex items-center gap-2">
              <img src="/logo.png" alt="Icon" class="w-3 h-3 opacity-70"/> promlify-os.exe
            </span>
            <div class="text-[10px] font-medium text-purple-300 bg-purple-900/30 border border-purple-500/30 px-2 py-0.5 rounded-full">Secure Node</div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 min-h-[500px]">
            
            <aside class="md:col-span-4 bg-[#050511]/40 border-r border-white/5 p-4 space-y-1">
              <button data-tab="image" class="tab-btn w-full text-left px-4 py-3 rounded-lg text-sm font-medium bg-gradient-to-r from-blue-900/40 to-purple-900/40 text-white transition-all flex items-center gap-3 shadow-sm border border-purple-500/30">
                <span class="w-2 h-2 rounded-full bg-blue-400 shadow-[0_0_8px_rgba(96,165,250,0.8)]"></span> AI Image
              </button>
              <button data-tab="video" class="tab-btn w-full text-left px-4 py-3 rounded-lg text-sm font-medium text-indigo-300/70 hover:text-white hover:bg-white/5 transition-all flex items-center gap-3 border border-transparent">
                <span class="w-2 h-2 rounded-full bg-transparent border border-indigo-500/50"></span> AI Video
              </button>
              <button data-tab="voice" class="tab-btn w-full text-left px-4 py-3 rounded-lg text-sm font-medium text-indigo-300/70 hover:text-white hover:bg-white/5 transition-all flex items-center gap-3 border border-transparent">
                <span class="w-2 h-2 rounded-full bg-transparent border border-indigo-500/50"></span> AI Voice
              </button>
            </aside>

            <div class="md:col-span-8 p-6 flex flex-col justify-between" id="dynamic-panel">
              <div id="content-fader" class="space-y-4 animate-fade-in">
                <div class="flex justify-between items-center">
                  <h3 class="text-lg font-bold text-white font-sans" id="panel-title">AI Image Generation</h3>
                  <span class="text-[10px] font-mono uppercase tracking-wider text-blue-300 bg-blue-900/40 border border-blue-500/40 px-2 py-0.5 rounded" id="panel-badge">GPT-4o Vision</span>
                </div>
                
                <textarea id="panel-input" rows="3" class="w-full bg-[#050511]/60 border border-white/10 rounded-lg p-3 text-sm text-white placeholder-indigo-300/40 focus:outline-none focus:border-purple-500/50 resize-none transition-colors shadow-inner" placeholder="Describe your idea..."></textarea>

                <div class="grid grid-cols-2 gap-3">
                  <div class="bg-white/5 border border-white/5 rounded-md p-2 text-xs backdrop-blur-sm">
                    <span class="text-indigo-300/70 block mb-1">Style Reference</span>
                    <span class="text-white font-medium font-mono" id="param-1">Hyper-Realistic</span>
                  </div>
                  <div class="bg-white/5 border border-white/5 rounded-md p-2 text-xs backdrop-blur-sm">
                    <span class="text-indigo-300/70 block mb-1">Aspect Ratio</span>
                    <span class="text-white font-medium font-mono" id="param-2">16:9 Cinema</span>
                  </div>
                </div>
                
                <div class="flex justify-end pt-2">
                   <button class="bg-gradient-to-r from-blue-600 to-purple-600 text-white font-semibold text-xs px-5 py-2.5 rounded-md hover:opacity-90 hover:shadow-[0_0_15px_rgba(139,92,246,0.6)] transition-all uppercase tracking-wider flex items-center gap-2" id="execute-btn">
                    Generate
                   </button>
                </div>

                <div class="pt-4 mt-2 border-t border-white/5">
                  <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-semibold text-indigo-300/70">Recent Output</span>
                  </div>
                  <div class="grid grid-cols-4 gap-2" id="image-gallery"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</Layout>

<!-- Keep your exact JavaScript script block here as it was! -->
<script is:inline>
  const imagesImage = [
    "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=200&q=80",
    "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=200&q=80",
    "https://images.unsplash.com/photo-1614729939124-032f0b56c9ce?w=200&q=80",
    "https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?w=200&q=80"
  ];
  const imagesVideo = [
    "https://images.unsplash.com/photo-1536240478700-b869070f9279?w=200&q=80",
    "https://images.unsplash.com/photo-1492691527719-9d1e07e534b4?w=200&q=80",
    "https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?w=200&q=80",
    "https://images.unsplash.com/photo-1485846234645-a62644f84728?w=200&q=80"
  ];
  const imagesVoice = [
    "https://images.unsplash.com/photo-1516280440502-3c5e883f3f2d?w=200&q=80",
    "https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?w=200&q=80",
    "https://images.unsplash.com/photo-1478737270239-2f02b77fc618?w=200&q=80",
    "https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?w=200&q=80"
  ];

  const tabData = {
    image: {
      title: "AI Image Generation", badge: "GPT-4o Vision",
      placeholder: "A hyper-realistic futuristic city with flying cars...",
      param1: "Hyper-Realistic", param2: "16:9 Cinema", btnText: "Generate Image",
      gallery: imagesImage
    },
    video: {
      title: "AI Video Render", badge: "Sora V2",
      placeholder: "Camera pans across a desert landscape at golden hour...",
      param1: "Cinematic Pan", param2: "4K 60fps", btnText: "Render Scene",
      gallery: imagesVideo
    },
    voice: {
      title: "AI Voice Cloning", badge: "ElevenLabs API",
      placeholder: "Paste script here to generate ultra-realistic speech...",
      param1: "Professional Male", param2: "High Stability", btnText: "Synthesize Audio",
      gallery: imagesVoice
    }
  };

  function renderGallery(images) {
    const gallery = document.getElementById('image-gallery');
    gallery.innerHTML = '';
    images.forEach(src => {
      gallery.innerHTML += `<img src="${src}" class="w-full h-16 md:h-20 object-cover rounded-md border border-white/10 hover:border-purple-400 hover:scale-110 hover:shadow-[0_0_15px_rgba(139,92,246,0.5)] transition-all cursor-pointer shadow-md" alt="AI Output"/>`;
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    renderGallery(tabData['image'].gallery);
    const buttons = document.querySelectorAll('.tab-btn');
    const fader = document.getElementById('content-fader');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetTab = btn.getAttribute('data-tab');
        const data = tabData[targetTab];
        if (!data) return;

        buttons.forEach(b => {
          b.className = 'tab-btn w-full text-left px-4 py-3 rounded-lg text-sm font-medium text-indigo-300/70 hover:text-white hover:bg-white/5 transition-all flex items-center gap-3 border border-transparent';
          b.querySelector('span').className = 'w-2 h-2 rounded-full bg-transparent border border-indigo-500/50';
        });

        btn.className = 'tab-btn w-full text-left px-4 py-3 rounded-lg text-sm font-medium bg-gradient-to-r from-blue-900/40 to-purple-900/40 text-white transition-all flex items-center gap-3 shadow-sm border border-purple-500/30';
        btn.querySelector('span').className = 'w-2 h-2 rounded-full bg-blue-400 shadow-[0_0_8px_rgba(96,165,250,0.8)]';

        fader.classList.remove('animate-fade-in');
        void fader.offsetWidth; 
        
        document.getElementById('panel-title').textContent = data.title;
        document.getElementById('panel-badge').textContent = data.badge;
        document.getElementById('panel-input').placeholder = data.placeholder;
        document.getElementById('param-1').textContent = data.param1;
        document.getElementById('param-2').textContent = data.param2;
        document.getElementById('execute-btn').innerHTML = `<svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg> ${data.btnText}`;
        
        renderGallery(data.gallery);
        fader.classList.add('animate-fade-in');
      });
    });
  });
</script>