---
import Layout from '../layouts/Layout.astro';

// We define our mock data here to simulate a real CMS backend
const featuredPost = {
  title: "Architecting AuraPrompt: The Zero-Latency Local Execution Engine",
  excerpt: "How we rebuilt our core inference pipeline from the ground up to bypass cloud bottlenecks and deliver real-time, structural generation on edge devices.",
  date: "July 12, 2026",
  category: "Engineering",
  readTime: "8 min read",
  image: "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=800&q=80"
};

const posts = [
  {
    title: "Introducing Temporal-V2: Cinematic Prompt Sequencing",
    excerpt: "Link multiple prompts across a unified timeline to generate cohesive short films with absolute temporal consistency.",
    date: "July 5, 2026",
    category: "Product Update",
    image: "https://images.unsplash.com/photo-1634017839464-5c339ebe3cb4?w=500&q=80"
  },
  {
    title: "The Future of Smart Context in Multi-Modal AI",
    excerpt: "Why maintaining deep contextual memory across complex sessions is the key to unlocking enterprise-grade generation workflows.",
    date: "June 28, 2026",
    category: "Research",
    image: "https://images.unsplash.com/photo-1614729939124-032f0b56c9ce?w=500&q=80"
  },
  {
    title: "Securing Edge Nodes: Our Encryption Standard",
    excerpt: "A deep dive into the cryptographic protocols protecting your prompts and proprietary generated assets on local hardware.",
    date: "June 15, 2026",
    category: "Security",
    image: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=500&q=80"
  }
];
---

<Layout title="Promlify | Engineering Blog">
  
  <!-- Blog Hero -->
  <section class="max-w-7xl mx-auto px-6 pt-32 pb-16 animate-fade-in">
    <div class="inline-flex items-center gap-2 border border-blue-500/30 bg-blue-900/20 backdrop-blur-sm px-4 py-1.5 rounded-full text-xs font-mono tracking-wider text-blue-200 mb-6 shadow-[0_0_15px_rgba(59,130,246,0.2)]">
      <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
      TRANSMISSIONS
    </div>
    <h1 class="text-5xl md:text-7xl font-black font-serif tracking-tight text-white mb-6">
      The Promlify <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-purple-400 to-fuchsia-400">Engineering Log.</span>
    </h1>
    <p class="text-lg text-indigo-200/80 max-w-2xl">
      Deep dives into our architecture, breakthrough AI research, and ecosystem release notes.
    </p>
  </section>

  <!-- Featured Post -->
  <section class="max-w-7xl mx-auto px-6 pb-20 relative animate-fade-in" style="animation-delay: 0.1s;">
    <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-1/2 h-1/2 bg-purple-600/10 blur-[120px] rounded-full -z-10"></div>
    
    <a href="#" class="group block relative rounded-2xl overflow-hidden bg-[#0A0A18]/80 backdrop-blur-xl border border-white/10 hover:border-purple-500/50 transition-all duration-500">
      <div class="grid grid-cols-1 lg:grid-cols-2">
        <!-- Image Half -->
        <div class="relative h-64 lg:h-full overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-t from-[#0A0A18] to-transparent lg:hidden z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-[#0A0A18] to-transparent hidden lg:block z-10"></div>
          <img src={featuredPost.image} alt={featuredPost.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-in-out opacity-80" />
        </div>
        <!-- Content Half -->
        <div class="p-8 md:p-12 flex flex-col justify-center relative z-20">
          <div class="flex items-center gap-4 mb-4">
            <span class="text-xs font-mono uppercase tracking-wider text-purple-400 bg-purple-900/30 border border-purple-500/30 px-3 py-1 rounded-full">{featuredPost.category}</span>
            <span class="text-sm text-indigo-200/50">{featuredPost.date}</span>
          </div>
          <h2 class="text-3xl md:text-4xl font-black text-white mb-4 group-hover:text-purple-300 transition-colors">
            {featuredPost.title}
          </h2>
          <p class="text-indigo-200/70 text-lg mb-8 leading-relaxed">
            {featuredPost.excerpt}
          </p>
          <div class="flex items-center gap-2 text-white font-medium text-sm group-hover:text-purple-400 transition-colors">
            Read Transmission <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </div>
      </div>
    </a>
  </section>

  <!-- Recent Posts Grid -->
  <section class="max-w-7xl mx-auto px-6 pb-32 animate-fade-in" style="animation-delay: 0.2s;">
    <div class="flex justify-between items-end mb-10 border-b border-white/10 pb-4">
      <h3 class="text-2xl font-bold text-white">Recent Architecture Updates</h3>
      <a href="#" class="text-sm text-indigo-200/60 hover:text-white transition-colors">View Archives →</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <a href="#" class="group bg-[#050511]/60 backdrop-blur-md border border-white/10 rounded-xl overflow-hidden hover:-translate-y-1 hover:border-blue-500/40 hover:shadow-[0_10px_30px_rgba(59,130,246,0.15)] transition-all duration-300 flex flex-col">
          <div class="h-48 overflow-hidden relative">
            <div class="absolute inset-0 bg-blue-600/20 mix-blend-overlay group-hover:opacity-0 transition-opacity z-10"></div>
            <img src={post.image} alt={post.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 grayscale group-hover:grayscale-0" />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center justify-between mb-4">
              <span class="text-[10px] font-mono uppercase tracking-wider text-blue-400">{post.category}</span>
              <span class="text-xs text-indigo-200/40">{post.date}</span>
            </div>
            <h4 class="text-lg font-bold text-white mb-3 group-hover:text-blue-300 transition-colors line-clamp-2">
              {post.title}
            </h4>
            <p class="text-sm text-indigo-200/60 leading-relaxed mb-6 flex-grow line-clamp-3">
              {post.excerpt}
            </p>
            <div class="text-xs font-semibold text-white/50 group-hover:text-white mt-auto flex items-center gap-1 transition-colors">
              Read article <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

</Layout>